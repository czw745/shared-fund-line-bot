name = "shared-fund-line-bot"
main = "src/index.ts"
compatibility_date = "2026-08-01"

[[d1_databases]]
binding = "DB"
database_name = "shared-fund-ledger"
database_id = "YOUR_D1_DATABASE_ID"
migrations_dir = "migrations"

[triggers]
# UTC 28–31 日 16:10；由 handler 篩選台北每月 1 日 00:10。
crons = ["10 16 28-31 * *", "0 1 1,3 * *"]

[vars]
GEMINI_DAILY_LIMIT = "100"
LINE_PUSH_MONTHLY_LIMIT = "200"
